# Ignore generated binaries (with no extension) by default
*
!*.*
!*/

.direnv/
.envrc
generated-docs/

# Benchmark corpus (Silesia), downloaded on demand by benchmark/corpus.roc
benchmark/.corpus/

# The catch-alls above ignore extensionless files, but this one must ship
!LICENSE

# Benchmark caches (decompression streams, driver builds, compressed output),
# regenerated on demand by benchmark/compress.roc and benchmark/decompress.roc
benchmark/.streams/
benchmark/.build/
benchmark/.work/

# Fuzz target builds and corpora (fuzz/smoke.roc), and roc-fuzz's reports
.fuzz/
.roc-fuzz/
